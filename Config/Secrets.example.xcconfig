// Secrets.example.xcconfig — committed template.
//
// Copy to `Secrets.xcconfig` (gitignored) and fill in. Values may differ per build
// configuration using the [config=...] suffix.
//
// NOTE: `//` starts a comment in xcconfig, so a URL cannot be written literally —
// "https://x" would be truncated to "https:". Hence the $(SLASH) indirection below.
SLASH = /

// Local stack from `supabase start`. Its anon key is the same on every install and is
// printed by `supabase status`; it grants nothing outside your machine.
ORIV_SUPABASE_URL[config=Debug] = http:$(SLASH)$(SLASH)127.0.0.1:54321
ORIV_SUPABASE_ANON_KEY[config=Debug] = paste-local-anon-key

// Hosted project. The anon key is publishable and RLS-gated — but it is kept out of git
// so secret scanners stay useful and a real leak isn't lost in the noise.
// NEVER put the service_role key here: it bypasses RLS entirely.
ORIV_SUPABASE_URL[config=Release] = https:$(SLASH)$(SLASH)your-project-ref.supabase.co
ORIV_SUPABASE_ANON_KEY[config=Release] = paste-hosted-anon-key
